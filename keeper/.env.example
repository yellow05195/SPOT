# SPOT keeper: inventory every 5 min, rarity at 23:50 UTC, hunt commit-reveal at 00:00 UTC.
NODE_ENV=development
LOG_LEVEL=info
CHAIN_RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
DATABASE_URL=postgres://spot:spot@localhost:5432/spot

# Deployed contracts
REGISTRY_ADDRESS=
VAULT_ADDRESS=
SWAPPER_ADDRESS=
# Uniswap V4 router and the settlement tokens on Robinhood Chain (needed for automatic inventory buying)
ROUTER_ADDRESS=
USDG_ADDRESS=
WETH_ADDRESS=

# The keeper's own key. It can only deposit into the vault and publish rarity/hunts, never withdraw.
# Production: keep it in a KMS/HSM-backed signer or a dedicated hot wallet with a small ETH balance for gas.
KEEPER_PRIVATE_KEY=

MIN_UNITS=200
MIN_COVERAGE_HOURS=4
UNIT_USD=0.5
SLIPPAGE_BPS=100
MAX_BRANDS_PER_BATCH=5
MAX_ETH_SHARE_BPS=8000
HUNT_COMMIT_DAYS=30
HUNT_SECRETS_FILE=./hunt-secrets.json
