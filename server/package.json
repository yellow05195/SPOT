{
  "name": "@spot/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SPOT — claim server : contrôles, vision, risque, signature EIP-712",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "models": "node scripts/fetch-models.mjs",
    "migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@aws-sdk/client-kms": "^3.1126.0",
    "@aws-sdk/client-s3": "^3.1126.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^9.0.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.1",
    "ioredis": "^5.6.1",
    "pino": "^9.9.0",
    "postgres": "^3.4.7",
    "sharp": "^0.35.4",
    "viem": "^2.56.3",
    "zod": "^4.1.11"
  },
  "optionalDependencies": {
    "onnxruntime-node": "^1.29.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@types/node": "^24.5.2",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
