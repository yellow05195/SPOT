# SPOT claim server. Copy to .env (dev) or set as secrets on the host (prod).
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Postgres and Redis. Optional in dev (memory fallbacks), REQUIRED in production.
# The schema is applied at boot by scripts/migrate.mjs (idempotent).
DATABASE_URL=postgres://spot:spot@localhost:5432/spot
REDIS_URL=redis://localhost:6379

# Robinhood Chain and the deployed contracts (see contracts/script/Deploy.s.sol output).
CHAIN_RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
VAULT_ADDRESS=
REGISTRY_ADDRESS=
SIGHTINGS_ADDRESS=

# Voucher signer. Production: an AWS KMS key (its ADDRESS is what Deploy.s.sol takes as SIGNER).
# Development only: a raw private key (refused when NODE_ENV=production unless ALLOW_HOT_SIGNER=true).
SIGNER_KMS_KEY_ID=
AWS_REGION=eu-west-1
SIGNER_DEV_PRIVATE_KEY=
# Explicit opt-in: accept SIGNER_DEV_PRIVATE_KEY in production (logged as an error at boot; migrate to KMS).
ALLOW_HOT_SIGNER=false

# Photo storage. Production: an S3-compatible bucket (AWS S3, Cloudflare R2, MinIO).
S3_BUCKET=
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
# Development: a local folder served by the API under /media. Also accepted in production without
# S3_BUCKET when it points to a persistent disk (a warning is logged).
MEDIA_LOCAL_DIR=./media
# Free-tier alternative: photos stored in Postgres and served by GET /media/:key (small webp files).
MEDIA_IN_DATABASE=false
# Public base URL of the served photos in production (e.g. https://api.example.com/media).
PUBLIC_MEDIA_BASE_URL=

# Vision. The Anthropic key powers the escalation (second opinion on doubtful photos); without it
# the doubtful band is refused. Models live in MODELS_DIR: clip-vision.onnx, face.onnx, plate.onnx, refs/.
# Missing .onnx files: `pnpm models` (scripts/fetch-models.mjs) downloads them.
ANTHROPIC_API_KEY=
VISION_MODEL=claude-opus-5
MODELS_DIR=./models

# Economy and checks
DAILY_BUDGET_USD=200
COUNTER_ANGLE_RATE=0.08
COUNTER_ANGLE_RATE_HIGH_RISK=0.4
VOUCHER_LIFETIME_S=1800
TRUSTED_PROXY=true
# "Cards first, fragments later": false validates and records sightings but pays 0 fragment.
FRAGMENTS_ENABLED=true
