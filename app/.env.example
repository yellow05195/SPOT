# Public URL of the site itself, no trailing slash. Used for canonical links, the sitemap and link previews.
NEXT_PUBLIC_SITE_URL=https://spot.example
# Claim server API (public URL in production, e.g. https://api.spot.example)
NEXT_PUBLIC_API_URL=http://localhost:3001
# Demo mode: fixed data, simulated verdicts, no server or chain needed. Set to 0 for the real thing.
NEXT_PUBLIC_DEMO=1
# Robinhood Chain and the deployed contracts (Deploy.s.sol output)
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_SIGHTINGS_ADDRESS=
NEXT_PUBLIC_PLATES_ADDRESS=
# Dev and demo only: the country the edge would report. In production the cf-ipcountry header decides.
NEXT_PUBLIC_GEO_DEV_COUNTRY=DE
